# Recast's virtual host for an nginx edge proxy that is shared with another site.
# Rendered by render.sh (only ${RECAST_DOMAIN} and ${RECAST_ALLOW} are substituted) and mounted
# into the edge's conf.d. It answers for RECAST_DOMAIN and nothing else: no default_server, no
# wildcard, so every other hostname, the bare IP and SNI-less clients keep going to the edge's own
# site. nginx picks the block by the Host header, so a request naming the other site always
# reaches that site.
#
# Public TLS is terminated by Cloudflare in front of RECAST_DOMAIN. In Flexible mode it reaches
# this edge over plain HTTP on port 80, so port 80 serves the app (Cloudflare already redirects
# visitors to https). Port 443 carries a self-signed certificate so that Full mode works too and
# the name can never fall through to the other site's TLS block.

server {
    listen 80;
    listen [::]:80;
    server_name ${RECAST_DOMAIN};
    # Visitors who typed http:// (Cloudflare says so in X-Forwarded-Proto) go to https before
    # anything asks for a password. Cloudflare's own https requests arrive here with "https".
    if ($http_x_forwarded_proto = "http") {
        return 301 https://$host$request_uri;
    }
    include /etc/recast-edge/proxy.inc;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${RECAST_DOMAIN};
    ssl_certificate     /etc/recast-edge/tls/fullchain.pem;
    ssl_certificate_key /etc/recast-edge/tls/privkey.pem;
    include /etc/recast-edge/proxy.inc;
}
