# Shared by both recast server blocks (rendered by render.sh).
server_tokens off;

# Only the CDN in front of RECAST_DOMAIN may connect; everyone else gets 403.
${RECAST_ALLOW}

add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "same-origin" always;

client_max_body_size 95m;             # recast.media.MAX_UPLOAD_BYTES is 90 MB

# Resolved per request, so the edge starts and reloads even when recast is down
# (this site alone then answers 502).
resolver 127.0.0.11 valid=10s;
set $recast_web recast-web;

location / {
    proxy_pass http://$recast_web:80;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header X-Real-IP $http_cf_connecting_ip;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;
}
