# Copy to .env and fill in. .env is git-ignored.
# ssh target of the GPU host (only used by tools/gpu_bench.sh to sample VRAM)
GPU_HOST=user@gpu-host
# ComfyUI's own address, read-only queue checks (tools/gpu_bench.sh)
COMFY_DIRECT=http://gpu-host:8188
# comfy-api-proxy, the address the Comfy SDK talks to (usually an ssh tunnel to the GPU host's loopback)
COMFY_BASE_URL=http://127.0.0.1:8189
# Optional second endpoint for quick GPU work (finding people, reading pictures, image-edit previews), so it never
# waits behind a render. Unset: everything uses COMFY_BASE_URL. COMFY_QUICK_API_KEY defaults to COMFY_API_KEY.
# COMFY_QUICK_BASE_URL=
